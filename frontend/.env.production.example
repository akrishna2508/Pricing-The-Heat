# Copy to .env.production (gitignored) for a Vercel/production build, or set
# this as an environment variable in the Vercel project settings.
#
# Must point at the deployed Render backend's base URL -- no trailing slash,
# and no path suffix (frontend/lib/api.ts appends routes like /heatmap
# itself). Falls back to http://localhost:8000 if unset, which is only
# correct for local development.
NEXT_PUBLIC_API_URL=https://pricing-the-heat-backend.onrender.com
