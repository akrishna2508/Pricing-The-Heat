.env
.env.*
!.env.*.example
__pycache__/
node_modules/
.venv/
.hypothesis/
frontend/.next/
frontend/next-env.d.ts
*.pt
*.pth
*.pkl
data/raw/*
!data/raw/*.meta.json
data/processed/*
models/artifacts/*
.pytest_cache/

# deploy_artifacts/ ships a fixed, small set of trained weights WITH the repo
# so Render's build (which has no access to local artifacts) can serve the
# API immediately -- deliberately un-ignored, unlike the *.pt/*.pkl/data
# patterns above which stay gitignored everywhere else.
!deploy_artifacts/
!deploy_artifacts/**
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/
