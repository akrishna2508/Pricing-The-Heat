.env
.env.*
!.env.*.example
__pycache__/
node_modules/
.venv/
.hypothesis/
frontend/.next/
frontend/next-env.d.ts
*.pt
*.pth
*.pkl
data/raw/*
!data/raw/*.meta.json
# admin1_in_us.geojson is real, public-domain Natural Earth boundary data
# (not a fetched API response cache) -- backend/data/geo_states.py's
# resolve_state() reads it at RUNTIME on the deployed API (no geocoding API,
# no key), so unlike the raw NASA POWER caches above, it must ship with the
# repo/Docker image, not stay gitignored. The other raw Natural Earth source
# files in data/raw/geo/ (e.g. ne_50m_admin_1_states_provinces.geojson) are
# regenerable build inputs, not runtime dependencies, and stay ignored.
!data/raw/geo/
data/raw/geo/*
!data/raw/geo/admin1_in_us.geojson
data/processed/*
models/artifacts/*
.pytest_cache/
.DS_Store

# Batch runner outputs -- regenerable per-run, not source (per-state weights/
# parquet/artifacts are already ignored above via models/artifacts + data/processed).
notebooks/artifacts/batch_manifest.json
notebooks/artifacts/batch_logs/
notebooks/artifacts/batch_stdout.log

# deploy_artifacts/ ships a fixed, small set of trained weights WITH the repo
# so Render's build (which has no access to local artifacts) can serve the
# API immediately -- deliberately un-ignored, unlike the *.pt/*.pkl/data
# patterns above which stay gitignored everywhere else.
!deploy_artifacts/
!deploy_artifacts/**
frontend/playwright-report/
frontend/test-results/
frontend/playwright/.cache/
